{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.gradle.enabled": true,
  "java.jdt.ls.java.home": "${env:USERPROFILE}/AppData/Roaming/Cursor/User/globalStorage/pleiades.java-extension-pack-jdk/java/21",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "${env:USERPROFILE}/AppData/Roaming/Cursor/User/globalStorage/pleiades.java-extension-pack-jdk/java/21",
      "default": true
    }
  ],
  "java.project.sourcePaths": ["backend/src/main/java"],
  "java.project.outputPath": "backend/build/classes/java/main",
  "java.project.referencedLibraries": ["backend/build/libs/**/*.jar"],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
}
