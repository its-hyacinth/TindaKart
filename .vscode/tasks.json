{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run TindaKart (Gradle)",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew.bat",
      "args": [
        "-g",
        "${workspaceFolder}/.gradle-home",
        ":backend:bootRun"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
